# =============================================================================
# eParking — centralna konfiguracija (RS2 3.3)
# Kopiraj u .env i prilagodi vrijednosti:  copy .env.example .env
# =============================================================================

# --- SQL Server (Docker) ---
MSSQL_SA_PASSWORD=eParking123!

# --- Connection string ---
# Docker (docker compose):
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=200146;User Id=sa;Password=eParking123!;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true;
# Lokalno (dotnet run) — zamijeni gornji red:
# ConnectionStrings__DefaultConnection=Server=localhost;Database=200146;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;

# --- JWT ---
Jwt__Key=eParkingDevJwtSecretKey2026MustBe32CharsMin!
Jwt__Issuer=eParking
Jwt__Audience=eParkingClients
Jwt__ExpiresMinutes=480

# --- RabbitMQ ---
# Docker:
RabbitMQ__Enabled=true
RabbitMQ__Host=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__Username=eparking
RabbitMQ__Password=eparking123
RabbitMQ__VirtualHost=/
RabbitMQ__NotificationQueue=eparking.notifications
# Lokalno (dotnet run, bez RabbitMQ-a) — postavi:
# RabbitMQ__Enabled=false
# RabbitMQ__Host=localhost
# RabbitMQ__Username=guest
# RabbitMQ__Password=guest

# --- SMTP (reset lozinke) ---
# Ostavite Host prazan za lokalni dev — kod se tada vraća u API odgovoru (Development).
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__UseSsl=true
Smtp__FromAddress=
Smtp__FromName=eParking

# --- CORS (API) ---
Cors__AllowedOrigins=http://localhost:5126,http://127.0.0.1:5126,http://10.0.2.2:5126

# --- Stripe (rezervisano, nije u upotrebi) ---
Stripe__SecretKey=
